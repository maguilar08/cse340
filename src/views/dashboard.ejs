<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <p><strong>Name:</strong> <%= name %></p>
    <p><strong>Username:</strong> <%= email %></p>

    <h2>My Volunteer Projects</h2>
    <!--W06-->
    <% if (volunteerProjects.length > 0) { %>

        <ul>
            <% volunteerProjects.forEach(project => { %>
                <li>
                    <strong>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </strong>

                    <p>Organization: <%= project.organization_name %></p>
                    <p>Location: <%= project.location %></p>

                    <form action="/project/<%= project.project_id %>/remove-volunteer" method="POST">
                        <button type="submit" class="add-organization-btn">
                            Remove Volunteering
                        </button>
                    </form>
                </li>
            <% }); %>
        </ul>

    <% } else { %>

        <p>You have not volunteered for any projects yet.</p>

    <% } %>

    <% if (user && user.role_name === 'admin') { %>
        <p>
            <a href="/users" class="add-organization-btn">
                View Registered Users
            </a>
        </p>
    <% } %>

</main>

<%- include('partials/footer') %>
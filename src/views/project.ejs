<%- include('partials/header') %>

<main>
    <h1><%= project.title %> Details</h1>
    <h2><%= project.title %></h2>
    <p><%= project.description %></p>

    <p>
        <strong>Date:</strong>
        <%= new Date(project.project_date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        }) %>
    </p>

    <p>
        <strong>Location:</strong>
        <%= project.location %>
    </p>

    <p>
        <strong>Partner Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    <!--W06-->
    <% if (isLoggedIn) { %>

        <% if (isVolunteering) { %>
            <p>
                <strong>You are volunteering for this project.</strong>
            </p>
    
            <form action="/project/<%= project.project_id %>/remove-volunteer" method="POST">
                <button type="submit" class="add-organization-btn">
                    Remove Volunteering
                </button>
            </form>
    
        <% } else { %>
    
            <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                <button type="submit" class="add-organization-btn">
                    Volunteer for This Project
                </button>
            </form>
    
        <% } %>
    
    <% } %>

    <h3>Categories</h3>

    <ul>
        <% categories.forEach(category => { %>
            <li>
                <a href="/category/<%= category.category_id %>">
                    <%= category.name %>
                </a>
            </li>
        <% }) %>
    </ul>

    <% if (user && user.role_name === 'admin') { %>
        <p>
            <a href="/edit-project/<%= project.project_id %>" class="add-organization-btn">
                Edit Project
            </a>
            <a href="/assign-categories/<%= project.project_id %>" class="add-organization-btn">
                Edit Categories
            </a>
        </p>
    <% } %>
</main>

<%- include('partials/footer') %>